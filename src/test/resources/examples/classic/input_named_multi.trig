@prefix ex: <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:Graph1 {
    ex:s1 a rdf:Statement ; rdf:subject ex:A1 ; rdf:predicate ex:p ; rdf:object ex:O1 .
    ex:s2 a rdf:Statement ; rdf:subject ex:A2 ; rdf:predicate ex:p ; rdf:object ex:O2 .
}

ex:Graph2 {
    ex:s3 a rdf:Statement ; rdf:subject ex:B1 ; rdf:predicate ex:p ; rdf:object ex:O3 .
    ex:s4 a rdf:Statement ; rdf:subject ex:B2 ; rdf:predicate ex:p ; rdf:object ex:O4 .
}