@prefix ex:  <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

_:b1 a rdf:Statement ;
    rdf:subject ex:Bob ;
    rdf:predicate ex:knows ;
    rdf:object ex:Alice ;
    ex:certainty "0.9" .

_:b2 a rdf:Statement ;
    rdf:subject ex:System ;
    rdf:predicate ex:validates ;
    rdf:object _:b1 ;
    ex:source "LogA" .