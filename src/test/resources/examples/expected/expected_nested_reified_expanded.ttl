@prefix ex:  <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:stmt1 rdf:reifies <<( ex:Bob ex:knows ex:Alice )>> ;
         ex:certainty "0.9" .

ex:stmt2 rdf:reifies <<( ex:System ex:validates <<( ex:Bob ex:knows ex:Alice )>> )>> ;
         ex:source "LogA" .