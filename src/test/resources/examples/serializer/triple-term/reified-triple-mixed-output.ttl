VERSION "1.2"
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ex: <http://example.org/>

<< ex:Jan ex:knows ex:Anna >> ex:confidence 0.9 .

ex:Warsaw rdf:type ex:City .

_:b0 ex:name "Piotr" ;
    ex:age 30 ;
    ex:worksFor ex:CompanyA .

ex:CompanyA ex:location ex:Warsaw ;
    ex:founded "2000"^^xsd:gYear .

