VERSION "1.2"
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ex: <http://example.org/>

<< ex:Product2 ex:hasPrice 19.99 >> ex:source ex:ShopA ;
    ex:currency "USD" .

<< ex:Car1 ex:belongsTo ex:User5 >> ex:status ex:Confirmed .

<< ex:Earth ex:orbits ex:Sun >> ex:factType ex:Scientific ;
    ex:theory ex:Heliocentrism .

<< ex:Piotr ex:worksAt ex:TechCorp >> ex:since "2010"^^xsd:gYear .

<< ex:Sun ex:risesIn ex:East >> ex:observedBy ex:Station1 .

<< ex:Adam ex:livesIn ex:Warsaw >> ex:verifiedBy ex:Admin .

<< ex:Jan ex:knows ex:Anna >> ex:accordingTo ex:Source1 .

<< ex:Bob ex:visited ex:Berlin >> ex:date "2022-05-20"^^xsd:date ;
    ex:mode ex:Train ;
    ex:accordingTo ex:Bob .

<< ex:Alice ex:created ex:ProjectX >> ex:date "2023-01-01"^^xsd:date .

<< ex:Mary ex:loves ex:Coffee >> ex:source ex:Survey2023 ;
    ex:confidence 0.95 .

